##################################################
# VirratPOS — .env.example
# Copy this file to .env and fill in your local values.
# NEVER commit your real .env to version control.
##################################################

# ----------------------------------------
# Application
# ----------------------------------------
APP_NAME='VirratPOS'
APP_ENV=local
# Run: php artisan key:generate  — this will fill in APP_KEY
APP_KEY=
APP_DEBUG=false
APP_LOG_LEVEL=debug
# Set to your local URL, e.g. http://localhost/virratpos (XAMPP) or http://virratpos.test
APP_URL=http://localhost/virratpos

# ----------------------------------------
# Database — MySQL (XAMPP default: root / no password)
# ----------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Create this database manually before running migrations: CREATE DATABASE virrat_pos;
DB_DATABASE=virrat_pos
DB_USERNAME=root
DB_PASSWORD=

# ----------------------------------------
# Core drivers
# ----------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# ----------------------------------------
# Redis (not required for basic local dev)
# ----------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----------------------------------------
# Mail — use Mailtrap (https://mailtrap.io) for local dev
# ----------------------------------------
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@virratpos.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: Mailgun
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=
# MAILGUN_ENDPOINT=api.mailgun.net

# Optional: Postmark
# POSTMARK_TOKEN=

# Optional: AWS SES
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional: Resend
# RESEND_KEY=

# ----------------------------------------
# Pusher (real-time notifications — leave blank to disable)
# ----------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# ----------------------------------------
# Social Login — Google OAuth
# Get credentials at: https://console.cloud.google.com/apis/credentials
# ----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ----------------------------------------
# Social Login — Facebook OAuth
# Get credentials at: https://developers.facebook.com/apps
# ----------------------------------------
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# ----------------------------------------
# PayPal
# Sandbox: https://developer.paypal.com/dashboard/
# ----------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_APP_ID=APP-80W284485P519543T
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_APP_ID=
PAYPAL_PAYMENT_ACTION=Sale
PAYPAL_CURRENCY=USD
PAYPAL_NOTIFY_URL=
PAYPAL_LOCALE=en_US
PAYPAL_VALIDATE_SSL=true

# ----------------------------------------
# PayTabs
# Dashboard: https://merchant.paytabs.com
# ----------------------------------------
paytabs_profile_id=
paytabs_server_key=
paytabs_currency=
# Accepted values: ARE, EGY, SAU, OMN, JOR, GLOBAL
paytabs_region=

# ----------------------------------------
# PayTR (Turkish payment gateway)
# Dashboard: https://www.paytr.com/magaza/entegrasyon
# ----------------------------------------
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_SALT=
PAYTR_MERCHANT_KEY=
PAYTR_BASE_URI=https://www.paytr.com
PAYTR_TIMEOUT=60
PAYTR_SUCCESS_URL=
PAYTR_FAIL_URL=
PAYTR_TEST_MODE=true

# ----------------------------------------
# Cashfree (Indian payment gateway)
# Dashboard: https://merchant.cashfree.com/merchants/login
# Use sandbox URL for testing, production URL for live
# ----------------------------------------
CASHFREE_URL=https://sandbox.cashfree.com/pg/orders

# ----------------------------------------
# Google reCAPTCHA (no-captcha package)
# Get keys at: https://www.google.com/recaptcha/admin
# ----------------------------------------
NOCAPTCHA_SECRET=
NOCAPTCHA_SITEKEY=

# ----------------------------------------
# Optional: Slack Notifications
# ----------------------------------------
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=
