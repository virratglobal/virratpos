##################################################
# VirratPOS — Laravel .gitignore
##################################################

# --- Laravel / PHP dependencies ---
/vendor
/node_modules

# --- Environment & secrets ---
.env
.env.backup
.env.*.local

# --- Storage runtime dirs (generated at runtime) ---
/public/storage
/public/hot
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!storage/framework/cache/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/views/.gitkeep
!storage/logs/.gitkeep

# --- Bootstrap cache (generated by artisan optimize) ---
/bootstrap/cache/*.php
!bootstrap/cache/.gitkeep

# --- PHP test results ---
.phpunit.result.cache
.phpunit.cache/

# --- Compiled assets (built by npm run build) ---
/public/build
/public/css/app.css
/public/js/app.js

# --- IDE / editor folders ---
/.idea
/.vscode
/.fleet
/.zed
/.cursor
*.swp
*.swo
*~

# --- OS artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Misc development scratch files ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Composer lock (keep this commented-out; commit composer.lock for reproducible installs) ---
# composer.lock
node_modules
